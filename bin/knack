#!/usr/bin/env bash
# knack — 개인 하네스 CLI. 사용법: knack help
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
KNACK_DIR="$(cd "$(dirname "$self")/.." && pwd)"
PY="$KNACK_DIR/lib/knack.py"

usage() {
  cat <<EOF
사용법: knack <명령>
  조회   list [종류] [--all]  show <종류> <이름> [--toc|--section N]  search <키워드>  doctor  skills
  모델   model [list|get|which|set]  run <작업|auto> [--agent] [--print] -- <프롬프트>
  측정   usage [--since 7d] [--by session|model|day|skill|cwd]  bench <init|run|compare|list>
  페르소나 persona [show|init|set|import|check|enable|disable]
  관리   add skill <경로|URL>  new <skill|rule|hook> <이름>  adopt skill <이름>  hook <enable|disable> <이름>
  설치   install [옵션]  status  update  uninstall [옵션]
  기타   help [스킬]  scan [경로]  test  version
자세한 내용: knack help
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
[ "$cmd" = ls ] && cmd=list

case "$cmd" in
  help|-h|--help)
    if [ $# -gt 0 ]; then
      exec python3 "$PY" show skill "$1"
    else
      cat "$KNACK_DIR/skills/knack-help/USAGE.md"
    fi ;;
  skills)    exec python3 "$PY" list skills "$@" ;;
  list|show|search|doctor|add|adopt|new|hook|model|run|usage|bench|persona)
             exec python3 "$PY" "$cmd" "$@" ;;
  status)    exec "$KNACK_DIR/install.sh" --status "$@" ;;
  install)   exec "$KNACK_DIR/install.sh" "$@" ;;
  update)    git -C "$KNACK_DIR" pull --ff-only && exec "$KNACK_DIR/install.sh" --global "$@" ;;
  uninstall) exec "$KNACK_DIR/install.sh" --uninstall "$@" ;;
  scan)      exec bash "$KNACK_DIR/skills/repo-onboarding/scripts/repo-scan.sh" "${1:-.}" ;;
  test)      exec bash "$KNACK_DIR/tests/smoke.sh" ;;
  version)   git -C "$KNACK_DIR" log -1 --format='%h (%ad) %s' --date=short ;;
  *)         echo "알 수 없는 명령: $cmd" >&2; usage >&2; exit 2 ;;
esac
